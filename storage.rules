rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Group files (logos, portadas, noticias, comprobantes) ─────────────────
    // Single wildcard covers files directly in the folder (logo.jpg, portada.jpg)
    match /grupos/{grupoId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Double wildcard covers nested paths (noticias/xxx.jpg, comprobantes/xxx.jpg)
    match /grupos/{grupoId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── User avatars (current path: usuarios/{uid}/avatar.jpg) ────────────────
    match /usuarios/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Legacy avatar path (old code used /avatars/) ──────────────────────────
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
