rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Group root files: logos and portadas ─────────────────────────────────
    // SEC-03 (partial): Storage Rules cannot query Firestore membership.
    // Full enforcement (verify active member) requires a signed-upload Cloud Function.
    // Mitigation: restrict file types and sizes; rely on Firestore Rules for data access.
    match /grupos/{grupoId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && (fileName == 'logo.jpg' || fileName == 'portada.jpg');
    }

    // ── Group nested files: noticias images ──────────────────────────────────
    match /grupos/{grupoId}/noticias/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Comprobantes de pago ──────────────────────────────────────────────────
    // TODO (SEC-03 full fix): replace with a Cloud Function that issues a signed URL
    // after verifying the requesting user is an active member of the group.
    match /grupos/{grupoId}/comprobantes/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Fallback for any other nested group path ──────────────────────────────
    match /grupos/{grupoId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // unknown paths require explicit rules above
    }

    // ── User avatars (current path: usuarios/{uid}/avatar.jpg) ────────────────
    match /usuarios/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Legacy avatar path (old code used /avatars/) ──────────────────────────
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
